# RevenueCat public SDK keys (Project → API keys → App-specific "public" key).
# These are publishable — safe in a client build — but keep the file untracked
# so the two apps' keys never get crossed.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Google Sign-In (Android). Web OAuth client id from Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
