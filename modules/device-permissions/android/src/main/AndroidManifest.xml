<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>

    <!-- The blocker. Watches for foreground-app changes and, when a blocked
         package comes to the front, puts the shield over it — see
         ByreAccessibilityService for the debounce and grant handling.

         (This comment used to describe a stub that only logged events. It was
         written before the service was implemented and never updated, which
         is worse than no comment at all: it cost a later reader a wrong
         conclusion about what the app does.) -->
    <service
      android:name="expo.modules.devicepermissions.ByreAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/byre_accessibility_service_config" />
    </service>

  </application>

</manifest>
