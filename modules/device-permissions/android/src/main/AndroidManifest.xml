<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>
    <!-- Stub service: declared and toggleable in system Settings so the
         "Accessibility" permission check has something real to point at.
         It currently only logs foreground-app change events — it does NOT
         yet draw the Shield overlay or block anything. That's the next
         real chunk of work, not implemented here. -->
    <service
      android:name="expo.modules.devicepermissions.WendAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/wend_accessibility_service_config" />
    </service>

    <!-- Stub notification listener — declared so the toggle is real; does
         not yet act on notifications from distracting apps. -->
    <service
      android:name="expo.modules.devicepermissions.WendNotificationListenerService"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>

</manifest>
