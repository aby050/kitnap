<!--
  The leaf inside its ring, for the shield cover.

  A vector rather than a PNG so it stays crisp at any density, and a drawable
  rather than a glyph because the cover must never depend on a font shipping
  the character it wants — a missing glyph renders as a tofu box in the one
  place the app has to look composed.

  Matches the mark the Gate draws in RN, so the cover and the screen it hands
  off to carry the same mark rather than two different ones.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

  <!-- The ring. -->
  <path
      android:pathData="M36,2.5 A33.5,33.5 0 1 1 35.99,2.5 Z"
      android:strokeColor="#3D6FE3A9"
      android:strokeWidth="1.5"
      android:fillColor="#14FFFFFF" />

  <!-- Leaf body: a lens, one curve up and one back. -->
  <path
      android:pathData="M47,25 C47,38 38,47 25,47 C25,34 34,25 47,25 Z"
      android:fillColor="#00000000"
      android:strokeColor="#E6FFFFFF"
      android:strokeWidth="2"
      android:strokeLineJoin="round"
      android:strokeLineCap="round" />

  <!-- Midrib. -->
  <path
      android:pathData="M45,27 L27,45"
      android:strokeColor="#E6FFFFFF"
      android:strokeWidth="2"
      android:strokeLineCap="round" />
</vector>
