<!--
  Deliberately minimal for battery: typeWindowStateChanged only (not
  typeAllMask — that would wake us on every scroll/tap system-wide),
  canRetrieveWindowContent=false since we only ever read event.packageName,
  and no accessibilityFlags since we don't need view-hierarchy metadata.
  notificationTimeout starts at a battery-friendly default and is then
  overridden at runtime per MonitoringConfigStore (see
  ByreAccessibilityService.applyMonitoringLevelIfChanged).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:canRetrieveWindowContent="false"
  android:description="@string/byre_accessibility_description"
  android:notificationTimeout="500" />
