{
  "expo": {
    "name": "Wend",
    "slug": "wend",
    "scheme": "wend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abhay050.wend",
      "appleTeamId": "RG96N3U9GH",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used only during Hard unlock challenges to confirm you're actually up and moving. Nothing is recorded or leaves your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "package": "com.abhay050.wend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Used only during Hard unlock challenges to confirm you're actually up and moving. Nothing is recorded or leaves your phone."
        }
      ],
      "expo-audio",
      "./plugins/withUsageStatsPermission.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "RG96N3U9GH",
          "appGroup": "group.com.abhay050.wend"
        }
      ]
    ]
  }
}
