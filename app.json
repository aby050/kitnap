{
  "expo": {
    "name": "Kitnap",
    "slug": "byre",
    "scheme": [
      "phonewise",
      "device-activity"
    ],
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abhay.phonewise",
      "appleTeamId": "RG96N3U9GH",
      "supportsTablet": false,
      "buildNumber": "3",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "Used for your progress photo. Photos stay on your phone.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "youtube",
          "snssdk1128",
          "fb",
          "snapchat",
          "twitter",
          "reddit",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Only if you choose to save a progress photo. Kitnap never reads your photo library.",
        "NSLocalNetworkUsageDescription": "Used only when running Kitnap from a development machine. The App Store build never connects to your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1EFEB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 13,
      "package": "com.abhay.byre"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-notifications",
      "./plugins/withUsageStatsPermission.js",
      "./plugins/withAndroidReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "RG96N3U9GH",
          "appGroup": "group.com.abhay.phonewise"
        }
      ],
      "./plugins/withShieldOpenApp.js",
      "./plugins/withIPhoneOnlyExtensions.js",
      "@react-native-community/datetimepicker",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "./plugins/withNoBackgroundAudio.js",
      "./plugins/withLauncherQueries.js",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.abhay.phonewise.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.phonewise"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.abhay.phonewise.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.phonewise"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.abhay.phonewise.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.phonewise"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "aef6ccde-8b87-4758-964e-b2f8a8139efe"
      }
    },
    "owner": "abhay050"
  }
}
