{
  "expo": {
    "name": "Byre",
    "slug": "byre",
    "scheme": [
      "byre",
      "device-activity"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abhay.byre",
      "appleTeamId": "RG96N3U9GH",
      "supportsTablet": true,
      "buildNumber": "7",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "Used for your progress photo, and during Hard unlock challenges to confirm you're actually up and moving. Photos stay on your phone.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "youtube",
          "snssdk1128",
          "fb",
          "snapchat",
          "twitter",
          "reddit",
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020C09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 4,
      "package": "com.abhay.byre"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Used for your progress photo, and during Hard unlock challenges to confirm you're actually up and moving. Photos stay on your phone."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-notifications",
      "./plugins/withUsageStatsPermission.js",
      "./plugins/withAndroidReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "RG96N3U9GH",
          "appGroup": "group.com.abhay.byre"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.abhay.byre.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.byre"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.abhay.byre.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.byre"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.abhay.byre.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.abhay.byre"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "aef6ccde-8b87-4758-964e-b2f8a8139efe"
      }
    },
    "owner": "abhay050"
  }
}
